{
  "log_level": "info",
  "log_format": "json",
  "scheduler": {
    "grpc_listen_addr": ":9090",
    "strategy": "round_robin",
    "discovery": {
      "mode": "kubernetes",
      "kubernetes": {
        "namespace": "agentenv-system",
        "service_name": "agentenv-nodes",
        "port": 8000,
        "scheme": "http"
      }
    },
    "redis_addr": "agentenv-redis:6379",
    "node_stream_enabled": true
  }
}
